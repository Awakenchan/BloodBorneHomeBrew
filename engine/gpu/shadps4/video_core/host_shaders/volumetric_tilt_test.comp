#version 450
#extension GL_GOOGLE_include_directive : require
#include "volumetric_tilt.glsl"

layout(local_size_x = 8) in;
struct Result { vec4 direction; vec4 warped; vec4 anchored; vec4 flags; };
layout(std430, binding = 0) writeonly buffer Results { Result values[]; };

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= 8u) return;
    const float angles[8] = float[](0, 15, 20, 25, 30, 20, 20, 20);
    vec3 original = normalize(vec3(1, 1, 0));
    vec3 up = vec3(0, 1, 0);
    mat3 camera = mat3(1);
    // A pitched/rolled camera must not change the world-space elevation correction.
    if (id == 5u) camera = mat3(vec3(0, 0, 1), vec3(1, 0, 0), vec3(0, 1, 0));
    if (id == 6u) original = vec3(cos(radians(10.0)), sin(radians(10.0)), 0);
    if (id == 7u) original = up;
    vec3 direction = transpose(camera) *
        shaft_direction(camera * original, camera * up, angles[id]);
    vec3 step = vec3(dot(normalize(vec3(1, -1, 0)), direction), direction.z,
                     dot(normalize(vec3(-1, -1, 0)), direction));
    vec3 p = vec3(0.25, 0.25, 0.6);
    vec2 warped = shaft_shadow_uv(p, 0.2, step);
    vec2 anchor = shaft_shadow_uv(p, p.z, step);
    values[id].direction = vec4(direction, 0);
    values[id].warped = vec4(warped, 0, 0);
    values[id].anchored = vec4(anchor, 0, 0);
    values[id].flags = vec4(float(shaft_inside_tile(warped, 0, vec2(0.01))),
                            float(shaft_inside_tile(vec2(0.51, 0.25), 0, vec2(0.01))),
                            float(shaft_inside_tile(vec2(0.75, 0.75), 3, vec2(0.01))),
                            float(shaft_inside_tile(vec2(0.49, 0.75), 3, vec2(0.01))));
}
