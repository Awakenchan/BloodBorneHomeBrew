#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D panorama;
layout(set = 0, binding = 1, rgba16f) uniform image2D horizontal_image;
layout(set = 0, binding = 2, rgba16f) uniform image2D result_image;
layout(set = 0, binding = 3, std430) readonly buffer Geometry { uint geometry[]; };
layout(set = 0, binding = 4, std430) buffer Validation { uint verified; };
layout(push_constant) uniform Params { uint level; uint count; uint isolate; float strength; } p;

vec3 encoded(vec3 linear_rgb) {
    return mix(12.92 * linear_rgb,
               1.055 * pow(max(linear_rgb, vec3(0)), vec3(1.0 / 2.4)) - 0.055,
               greaterThan(linear_rgb, vec3(0.0031308)));
}

bool known_panorama() {
    // Measured base-mip samples; allow one encoded byte for BC1 interpolation rounding.
    const ivec2 at[16] = ivec2[](
        ivec2(0, 0), ivec2(128, 4), ivec2(256, 8), ivec2(512, 12),
        ivec2(768, 16), ivec2(1024, 24), ivec2(1280, 32), ivec2(1536, 48),
        ivec2(1792, 64), ivec2(2047, 80), ivec2(32, 128), ivec2(320, 256),
        ivec2(640, 320), ivec2(960, 384), ivec2(1280, 448), ivec2(1920, 511));
    const vec3 expected[16] = vec3[](
        vec3(8, 14, 21), vec3(8, 16, 21), vec3(10, 17, 24), vec3(10, 17, 27),
        vec3(13, 21, 30), vec3(16, 24, 33), vec3(18, 29, 41), vec3(24, 37, 51),
        vec3(27, 45, 60), vec3(41, 56, 74), vec3(49, 73, 93), vec3(115, 125, 123),
        vec3(142, 148, 148), vec3(123, 134, 132), vec3(79, 89, 90), vec3(99, 98, 90));
    if (textureSize(panorama, 0) != ivec2(2048, 512)) return false;
    for (int i = 0; i < 16; ++i) {
        vec3 value = round(encoded(texelFetch(panorama, at[i], 0).rgb) * 255.0);
        if (any(greaterThan(abs(value - expected[i]), vec3(1)))) return false;
    }
    return true;
}

void main() {
#ifdef VALIDATE
    if (any(notEqual(gl_GlobalInvocationID, uvec3(0)))) return;
    verified = geometry[p.count] == 1u && known_panorama() ? 1u : 0u;
#else
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(panorama, int(p.level));
    if (any(greaterThanEqual(at, size))) return;
    vec4 original = texelFetch(panorama, at, int(p.level));
    float base_y = (float(at.y) + 0.5) * exp2(float(p.level));
    float luminance = dot(original.rgb, vec3(0.2126, 0.7152, 0.0722));
    float amount = (1.0 - smoothstep(32.0, 96.0, base_y)) *
                   (1.0 - smoothstep(0.03, 0.08, luminance));
    if (p.isolate == 3u) {
        // Restore authored variation gradually, without a brightness-dependent boundary.
        float t = clamp(base_y / 224.0, 0.0, 1.0);
        amount = p.strength * (1.0 - t * t * t * (t * (t * 6.0 - 15.0) + 10.0));
    }
    vec3 value = original.rgb;
#ifdef HORIZONTAL
    if (verified == 1u && p.isolate == 3u) {
        if (at.x != 0) return;
        vec3 sum = vec3(0);
        for (int x = 0; x < size.x; ++x)
            sum += texelFetch(panorama, ivec2(x, at.y), int(p.level)).rgb;
        imageStore(horizontal_image, at, vec4(sum / float(size.x), original.a));
        return;
    }
#endif
    if (verified == 1u && p.isolate == 1u) {
        value = vec3(0.03, 0.05, 0.08);
    } else if (verified == 1u && amount > 0.0) {
#ifdef HORIZONTAL
        int radius = max(1, int(64u >> p.level));
        float sigma = max(0.75, 24.0 / exp2(float(p.level)));
        vec3 center = original.rgb;
#else
        int radius = max(1, int((p.isolate == 3u ? 32u : 8u) >> p.level));
        float sigma = max(0.75, (p.isolate == 3u ? 12.0 : 3.0) / exp2(float(p.level)));
        vec3 center = imageLoad(horizontal_image, p.isolate == 3u ? ivec2(0, at.y) : at).rgb;
#endif
        vec3 sum = vec3(0);
        float weights = 0.0;
        for (int i = -radius; i <= radius; ++i) {
#ifdef HORIZONTAL
            ivec2 sample_at = ivec2((at.x + i + size.x) % size.x, at.y);
            vec3 sample_rgb = texelFetch(panorama, sample_at, int(p.level)).rgb;
#else
            ivec2 sample_at = ivec2(p.isolate == 3u ? 0 : at.x,
                                   clamp(at.y + i, 0, size.y - 1));
            vec3 sample_rgb = imageLoad(horizontal_image, sample_at).rgb;
#endif
            vec3 delta = sample_rgb - center;
            float color_distance = p.isolate == 3u ? 0.0 :
                                   dot(delta, delta) / (2.0 * 0.004 * 0.004);
            float weight = exp(-float(i * i) / (2.0 * sigma * sigma) - color_distance);
            sum += sample_rgb * weight;
            weights += weight;
        }
#ifdef HORIZONTAL
        value = sum / weights;
#else
        value = mix(original.rgb, sum / weights, amount);
#endif
    }
#ifdef HORIZONTAL
    imageStore(horizontal_image, at, vec4(value, original.a));
#else
    imageStore(result_image, at, vec4(value, original.a));
#endif
#endif
}
