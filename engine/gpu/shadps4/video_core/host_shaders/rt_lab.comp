#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32f) uniform writeonly image2D out_img;
layout(set = 0, binding = 1) uniform accelerationStructureEXT scene;

layout(push_constant) uniform Constants {
    layout(row_major) mat4 to_view;
    vec2 size;
    vec2 region_min;
    vec2 region_max;
    uint perspective;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    if (any(lessThan(uv, region_min)) || any(greaterThanEqual(uv, region_max))) {
        return;
    }
    rayQueryEXT query;
    if (perspective != 0u) {
        vec4 v = to_view * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 1.0);
        vec3 dir = v.xyz / v.w;
        rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xffu, vec3(0.0), 0.00001, dir, 1.0);
        rayQueryProceedEXT(query);
        float depth = 1.0;
        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            float z = rayQueryGetIntersectionTEXT(query, true) * dir.z;
            vec4 c = inverse(to_view) * vec4(0.0, 0.0, z, 1.0);
            depth = c.z / c.w;
        }
        imageStore(out_img, pixel, vec4(depth));
        return;
    }
    vec4 a = to_view * vec4(uv, 0.0, 1.0);
    vec4 b = to_view * vec4(uv, 1.0, 1.0);
    vec3 origin = a.xyz / a.w;
    vec3 dir = b.xyz / b.w - origin;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xffu, origin, 0.0, dir, 1.0);
    rayQueryProceedEXT(query);
    float depth = 1.0;
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        depth = rayQueryGetIntersectionTEXT(query, true);
    }
    imageStore(out_img, pixel, vec4(depth));
}
