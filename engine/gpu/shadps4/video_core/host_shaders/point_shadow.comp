#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(scalar, set = 0, binding = 0) readonly buffer Data { uint d[]; } data;
layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2, r11f_g11f_b10f) uniform image2D cur0;
layout(set = 0, binding = 3, r11f_g11f_b10f) uniform readonly image2D snap0;
layout(set = 0, binding = 4, r11f_g11f_b10f) uniform image2D cur1;
layout(set = 0, binding = 5, r11f_g11f_b10f) uniform readonly image2D snap1;

layout(push_constant) uniform Constants {
    uint first_light;
    uint frame_index;
    vec2 size;
    float length_m;
    float thickness_m;
    float strength;
    float fade_start_m;
    float fade_end_m;
    uint light_count;
    uint steps;
    float bias_m;
    ivec4 rect;
};

shared mat4 shared_inverse;
shared mat4 shared_projection;
mat4 projMat;
vec4 invZ, invW;

float word(uint i) { return uintBitsToFloat(data.d[i]); }
vec4 row(uint i) { return vec4(word(i), word(i + 1u), word(i + 2u), word(i + 3u)); }
float lb(uint k, uint i) { return word(first_light + k * 16u + i); }

float sceneDepth(vec2 uv) { return textureLod(depth_tex, uv, 0.0).x; }

vec3 viewPosAt(vec2 uv, float depth) {
    vec4 c = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec4 v = shared_inverse * c;
    return v.xyz / v.w;
}

float viewZAt(vec2 uv, float depth) {
    vec4 c = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return dot(invZ, c) / dot(invW, c);
}

float hash(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float visibility(vec3 P, vec3 L, vec2 uv0, float jitter) {
    vec3 to = L - P;
    float dist = length(to);
    float reach = min(dist - 0.25, length_m);
    if (!(reach > 0.05)) {
        return 1.0;
    }
    vec3 dir = to / dist;
    uint count = steps;
    vec4 tip = projMat * vec4(P + dir * reach, 1.0);
    if (tip.w > 0.0) {
        float span = length((tip.xy / tip.w * vec2(0.5, -0.5) + 0.5 - uv0) * size);
        if (span < 1.0) {
            return 1.0;
        }
        count = clamp(uint(span / 2.0), min(4u, steps), steps);
    }
    for (uint i = 0u; i < count; ++i) {
        float t = (float(i) + 0.5 + jitter) / float(count);
        t *= t;
        float s = 0.03 + t * reach;
        vec3 Q = P + dir * s;
        if (!(Q.z > 0.0)) {
            break;
        }
        vec4 n4 = projMat * vec4(Q, 1.0);
        if (!(n4.w != 0.0)) {
            break;
        }
        vec2 uv = n4.xy / n4.w * vec2(0.5, -0.5) + 0.5;
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
            break;
        }
        float sd = sceneDepth(uv);
        if (!(sd < 1.0) || !(sd > 0.0)) {
            continue;
        }
        float diff = Q.z - viewZAt(uv, sd);
        float bias = bias_m + 0.006 * P.z + 0.03 * s;
        if (diff > bias && diff < thickness_m) {
            return 0.0;
        }
    }
    return 1.0;
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        shared_inverse = transpose(mat4(row(0u), row(4u), row(8u), row(12u)));
        shared_projection = inverse(shared_inverse);
    }
    barrier();

    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x < rect.x || px.y < rect.y || px.x >= rect.z || px.y >= rect.w) {
        return;
    }
    const vec3 s0 = imageLoad(snap0, px).rgb;
    const vec3 c0 = imageLoad(cur0, px).rgb;
    const vec3 s1 = imageLoad(snap1, px).rgb;
    const vec3 c1 = imageLoad(cur1, px).rgb;
    if (all(lessThanEqual(c0, s0)) && all(lessThanEqual(c1, s1))) {
        return;
    }

    vec2 uv0 = (vec2(px) + 0.5) / size;
    float d0 = sceneDepth(uv0);
    if (!(d0 < 1.0) || !(d0 > 0.0)) {
        return;
    }
    vec3 P = viewPosAt(uv0, d0);
    if (!(P.z > 0.0)) {
        return;
    }
    float fade = 1.0 - smoothstep(fade_start_m, fade_end_m, P.z);
    if (fade <= 0.0) {
        return;
    }

    projMat = shared_projection;
    const mat4 inverse_now = shared_inverse;
    invZ = vec4(inverse_now[0][2], inverse_now[1][2], inverse_now[2][2], inverse_now[3][2]);
    invW = vec4(inverse_now[0][3], inverse_now[1][3], inverse_now[2][3], inverse_now[3][3]);
    float jitter = hash(uv0 * size + float(frame_index & 63u) * 7.13);
    float wsum = 0.0;
    float vsum = 0.0;
    for (uint k = 0u; k < light_count; ++k) {
        float inv_r2 = lb(k, 3u);
        if (!(inv_r2 > 0.0)) {
            continue;
        }
        float inv_r = sqrt(inv_r2);
        vec3 L = vec3(lb(k, 0u), lb(k, 1u), lb(k, 2u));
        float t = length(L - P) * inv_r;
        if (t >= 1.0) {
            continue;
        }
        vec3 col = vec3(lb(k, 4u), lb(k, 5u), lb(k, 6u));
        float w = (1.0 - t * t);
        w *= w * dot(col, vec3(0.299, 0.587, 0.114));
        if (!(w > 1e-5)) {
            continue;
        }
        wsum += w;
        vsum += w * visibility(P, L, uv0, jitter);
    }
    if (!(wsum > 0.0)) {
        return;
    }
    float v = vsum / wsum;
    float k = strength * fade;
    float scale = mix(1.0, v, k);

    imageStore(cur0, px, vec4(s0 + max(c0 - s0, vec3(0.0)) * scale, 1.0));
    imageStore(cur1, px, vec4(s1 + max(c1 - s1, vec3(0.0)) * scale, 1.0));
}
