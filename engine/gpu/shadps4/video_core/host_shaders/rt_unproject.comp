#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer Positions { vec4 p[]; } positions;

layout(push_constant) uniform Constants {
    vec4 row0;
    vec4 row1;
    vec4 row2;
    uint first;
    uint count;
};

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id >= count) {
        return;
    }
    const vec4 clip = positions.p[first + id];
    positions.p[first + id] = vec4(dot(row0, clip), dot(row1, clip), dot(row2, clip), 1.0);
}
