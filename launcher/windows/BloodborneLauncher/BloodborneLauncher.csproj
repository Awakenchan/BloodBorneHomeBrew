<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lantern Engine</AssemblyName>
    <RootNamespace>BloodborneLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.9</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BBFSSDistribution)' == 'true'">
    <AssemblyName>BBFSS</AssemblyName>
    <DefineConstants>$(DefineConstants);BBFSS_DISTRIBUTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source fingerprint the builder writes beside the exe; shared so both agree on it. -->
    <Compile Include="..\Shared\SourceStamp.cs" Link="Core\SourceStamp.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="BloodborneLauncher.Localization.%(Filename)%(Extension)" />
    <Resource Include="lantern-beta.ico" />
    <Resource Include="lantern-stable.ico" />
    <Resource Include="lantern-j3loo.ico" />
    <Resource Include="Assets\discord-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
